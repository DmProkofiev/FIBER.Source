<UserControl x:Class="FIBER.Source.Views.UpdateCompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FIBER.Source.ViewModels"
             xmlns:helpers="clr-namespace:FIBER.Source.Models.Helpers">
    <Border Background="#D8171717" CornerRadius="15" Margin="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Редактирование организации"
                       FontFamily="Times New Roman" FontSize="28" FontWeight="Bold"
                       Foreground="White" Margin="30,20,30,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,15,0" Padding="30,5,10,20">
                <StackPanel MaxWidth="800">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Рег. номер:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Телефон:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Email:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Сайт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Заметки:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </Grid>

                    <!-- ================= ВЗАИМОДЕЙСТВИЯ «КОМПАНИЯ → КОМПАНИЯ» ================= -->
                    <Expander Header="Взаимодействия с организациями" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <!-- Выбор цели нового взаимодействия -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableCompanies}"
                                          SelectedValue="{Binding SelectedTargetCompanyId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"/>
                                <Button Grid.Column="1" Content="+ Добавить взаимодействие"
                                        Command="{Binding AddInteractionCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Background="#27AE60" Foreground="White" FontFamily="Times New Roman"
                                        FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Interactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Название целевой организации: редактируемые — TextBox, обратные — метка -->
                                                <TextBox Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True"
                                                         Margin="0,0,6,0">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReverseOnly}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                           Foreground="#AAAAAA" FontStyle="Italic"
                                                           FontFamily="Times New Roman" FontSize="14"
                                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReverseOnly}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                                          IsEditable="True"
                                                          Text="{Binding InteractionType, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,6,0">
                                                    <ComboBoxItem Content="Партнёр"/>
                                                    <ComboBoxItem Content="Конкурент"/>
                                                    <ComboBoxItem Content="Поставщик"/>
                                                    <ComboBoxItem Content="Подрядчик"/>
                                                    <ComboBoxItem Content="Учредитель"/>
                                                    <ComboBoxItem Content="Аффилированное лицо"/>
                                                    <ComboBoxItem Content="Другое"/>
                                                </ComboBox>
                                                <TextBox Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,6,0"/>
                                                <Button Grid.Column="3" Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveInteractionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReverseOnly}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Взаимодействия не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Interactions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Серые курсивные строки — взаимодействия, инициированные другой организацией (изменяются в её карточке)."
                                       Foreground="#AAAAAA" FontSize="11" FontStyle="Italic" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Expander>

                    <!-- ================= БЛОК СУЩЕСТВУЮЩИХ МЕДИА ================= -->
                    <Expander Header="Существующие медиа" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="5">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="Фото">
                                <ItemsControl ItemsSource="{Binding ExistingImages}" Margin="0,5,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="100" Height="100" Margin="5">
                                                <Border CornerRadius="4" ClipToBounds="True" Background="#DDD">
                                                    <Image Source="{Binding ImageSource}" Stretch="Uniform" />
                                                </Border>
                                                <Button Content="×" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.DeleteExistingMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                            <TabItem Header="Видео">
                                <ItemsControl ItemsSource="{Binding ExistingVideos}" Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="150" Height="50" Margin="5">
                                                <Border Background="#2C3E50" CornerRadius="4" Padding="5">
                                                    <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Button Content="×" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.DeleteExistingMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                            <TabItem Header="Аудио">
                                <ItemsControl ItemsSource="{Binding ExistingAudio}" Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="150" Height="50" Margin="5">
                                                <Border Background="#27AE60" CornerRadius="4" Padding="5">
                                                    <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Button Content="×" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.DeleteExistingMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                        </TabControl>
                    </Expander>

                    <!-- ================= ЗОНА DRAG & DROP ================= -->
                    <Border Margin="0,20,0,0" Height="110" CornerRadius="8"
                            BorderBrush="#55000000" BorderThickness="2"
                            Background="#33FFFFFF"
                            AllowDrop="True"
                            Drop="DropZone_Drop"
                            DragOver="DropZone_DragOver"
                            DragLeave="DropZone_DragLeave">
                        <Grid>
                            <TextBlock Text="Перетащите сюда новые изображения или файлы"
                                       FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5">
                                <ItemsControl ItemsSource="{Binding TempFiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="90" Height="90" Margin="5">
                                                <Border CornerRadius="4" ClipToBounds="True" Background="#DDDDDD" ToolTip="{Binding FileName}">
                                                    <Grid>
                                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Padding="5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveTempFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Width="22" Height="22"
                                                        Background="#CCFF0000" Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,-5,-5,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,10">
                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="200" Height="46" FontSize="18" Margin="0,0,16,0" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Отмена" Command="{Binding CancelCommand}" Width="160" Height="46" FontSize="18">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#7F7F7F"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>