<UserControl x:Class="FIBER.Source.Views.UpdateCompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FIBER.Source.ViewModels"
             xmlns:helpers="clr-namespace:FIBER.Source.Models.Helpers"
             xmlns:local="clr-namespace:FIBER.Source.Views">
    <Border Background="#D8171717" CornerRadius="15" Margin="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Редактирование организации"
                       FontFamily="Times New Roman" FontSize="28" FontWeight="Bold"
                       Foreground="White" Margin="30,20,30,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,15,0" Padding="30,5,10,20">
                <StackPanel MaxWidth="800">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Рег. номер:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Телефон:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Email:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Сайт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Заметки:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalAlignment="Stretch"/>
                    </Grid>

                    <!-- ================= ВЗАИМОДЕЙСТВИЯ «КОМПАНИЯ → КОМПАНИЯ» ================= -->
                    <Expander Header="Взаимодействия с организациями" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <!-- Выбор цели нового взаимодействия -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableCompanies}"
                                          SelectedValue="{Binding SelectedTargetCompanyId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"/>
                                <Button Grid.Column="1" Content="Добавить"
                                        Command="{Binding AddInteractionCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonGreen}"
                                        FontWeight="Bold" BorderThickness="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Interactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Подписи -->
                                                <TextBlock Grid.Column="0" Text="Организация" FontSize="12" FontWeight="Bold"
                                                           Foreground="#CCCCCC" Margin="0,0,6,2"/>
                                                <TextBlock Grid.Column="1" Text="Тип взаимодействия" FontSize="12" FontWeight="Bold"
                                                           Foreground="#CCCCCC" Margin="0,0,6,2"/>
                                                <TextBlock Grid.Column="2" Text="Заметки" FontSize="12" FontWeight="Bold"
                                                           Foreground="#CCCCCC" Margin="0,0,6,2"/>
                                                <!-- Название целевой организации: редактируемые — TextBox, обратные — метка -->
                                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True"
                                                         Margin="0,0,6,0">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReverseOnly}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayName}"
                                                           Foreground="#AAAAAA" FontStyle="Italic"
                                                           FontFamily="Times New Roman" FontSize="14"
                                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReverseOnly}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                                          
                                                          Text="{Binding InteractionType, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,6,0"/>
                                                    
                                                    
                                                    
                                                    
                                                    
                                                    
                                                    
                                                
                                                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,6,0" VerticalAlignment="Stretch"/>
                                                <Button Grid.Row="1" Grid.Column="3" Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveInteractionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReverseOnly}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Взаимодействия не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Interactions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Серые курсивные строки — взаимодействия, инициированные другой организацией (изменяются в её карточке)."
                                       Foreground="#AAAAAA" FontSize="11" FontStyle="Italic" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Expander>

                    

                    <!-- ================= СВЯЗИ С ПЕРСОНАМИ ================= -->
                    <Expander Header="Связи с персонами" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailablePersons}"
                                          SelectedValue="{Binding SelectedTargetPersonId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"/>
                                <Button Grid.Column="1" Content="Добавить"
                                        Command="{Binding AddPersonCompanyCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonGreen}"
                                        FontWeight="Bold" BorderThickness="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CompanyPeople}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="Персона" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding PersonName, Mode=OneWay}" IsReadOnly="True"
                                                         Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,6"/>
                                                
                                                <TextBlock Text="Роль" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                         Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,0,6"/>
                                                
                                                <TextBlock Text="Заметки" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,6" VerticalAlignment="Stretch"/>
                                                
                                                <Button Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemovePersonCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Связи с персонами не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompanyPeople.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- ================= СВЯЗИ С СОБЫТИЯМИ ================= -->
                    <Expander Header="Связи с событиями" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableEvents}"
                                          SelectedValue="{Binding SelectedTargetEventId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Title"/>
                                <Button Grid.Column="1" Content="Добавить"
                                        Command="{Binding AddEventParticipationCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonGreen}"
                                        FontWeight="Bold" BorderThickness="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding EventParticipations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True"
                                                         Margin="0,0,6,0" VerticalAlignment="Stretch"/>
                                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                                          ItemsSource="{x:Static helpers:EventParticipantRoles.AllOptions}"
                                                          SelectedValue="{Binding Role}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Display"
                                                          Margin="0,0,6,0" VerticalAlignment="Stretch"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                                           Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                           Margin="0,0,6,0" VerticalAlignment="Stretch"/>
                                                <Button Grid.Column="3" Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveEventParticipationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Связи с событиями не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EventParticipations.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                                        <Expander Header="МедиаДанные" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="5">
                        
                        <TabControl Style="{StaticResource MediaTabControlStyle}">
                            <TabItem Header="Фото" Style="{StaticResource MediaTabItemStyle}">
                                <ListBox ItemsSource="{Binding ExistingImages}" Margin="0,5,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaImageCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Превью изображения -->
                                                    <Border Grid.Row="0" Background="#0A000000" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding ImageSource}" Stretch="Uniform">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ImageSource}" Value="{x:Null}"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- Загрузка -->
                                                            <TextBlock Text="Загрузка…" Foreground="#AAA" FontSize="10"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsImage}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsImageLoading}" Value="True"/>
                                                                                    <Condition Binding="{Binding ImageSource}" Value="{x:Null}"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsImageLoading}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя + кнопка удаления -->
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Content="×" Grid.Column="1" Width="22" Height="22"
                                                                Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                                Command="{Binding DataContext.DeleteExistingMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Template="{StaticResource CloseButtonTemplate}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>

                            <TabItem Header="Видео" Style="{StaticResource MediaTabItemStyle}">
                                <ListBox ItemsSource="{Binding ExistingVideos}" Margin="0,5,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaVideoCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Плеер видео -->
                                                    <Border Grid.Row="0" Background="#000000" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <MediaElement Source="{Binding FilePath}"
                                                                          LoadedBehavior="Manual"
                                                                          Stretch="Uniform"
                                                                          Margin="0"/>
                                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                        Margin="6" Orientation="Horizontal">
                                                                <Button Content="Play" Style="{StaticResource MediaPlayButtonStyle}"
                                                                        Click="MediaPlay_Click"/>
                                                                <Button Content="Пауза" Style="{StaticResource MediaPauseButtonStyle}"
                                                                        Click="MediaPause_Click"/>
                                                                <Button Content="Стоп" Style="{StaticResource MediaStopButtonStyle}"
                                                                        Click="MediaStop_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя + кнопка удаления -->
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="×" Width="22" Height="22"
                                                                Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                                Command="{Binding DataContext.DeleteExistingMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>

                            <TabItem Header="Аудио" Style="{StaticResource MediaTabItemStyle}">
                                <ListBox ItemsSource="{Binding ExistingAudio}" Margin="0,5,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaAudioCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Плеер аудио -->
                                                    <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <MediaElement Source="{Binding FilePath}"
                                                                          LoadedBehavior="Manual"
                                                                          Stretch="None"
                                                                          Margin="0"/>
                                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                        Margin="6" Orientation="Horizontal">
                                                                <Button Content="Play" Style="{StaticResource MediaPlayButtonStyle}"
                                                                        Click="MediaPlay_Click"/>
                                                                <Button Content="Пауза" Style="{StaticResource MediaPauseButtonStyle}"
                                                                        Click="MediaPause_Click"/>
                                                                <Button Content="Стоп" Style="{StaticResource MediaStopButtonStyle}"
                                                                        Click="MediaStop_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя + кнопка удаления -->
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="×" Width="22" Height="22"
                                                                Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                                Command="{Binding DataContext.DeleteExistingMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                    </Expander>

                    <local:MediaStorageButton Command="{Binding AddExistingMediaCommand}"/>
                    <Border Margin="0,20,0,0" Height="110" CornerRadius="8"
                            BorderBrush="#55000000" BorderThickness="2"
                            Background="#33FFFFFF"
                            AllowDrop="True"
                            Drop="DropZone_Drop"
                            DragOver="DropZone_DragOver"
                            DragLeave="DropZone_DragLeave">
                        <Grid>
                            <TextBlock Text="Перетащите сюда новые изображения или файлы"
                                       FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5">
                                <ItemsControl ItemsSource="{Binding TempFiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="90" Height="90" Margin="5">
                                                <Border CornerRadius="4" ClipToBounds="True" Background="#DDDDDD" ToolTip="{Binding FileName}">
                                                    <Grid>
                                                        <Image Source="{Binding ImageSource}" Stretch="Uniform">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Padding="5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveTempFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Width="22" Height="22"
                                                        Background="#CCFF0000" Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,-5,-5,0"
                                                        Template="{StaticResource CloseButtonTemplate}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,10">
                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="200" Height="46" FontSize="18" Margin="0,0,16,0" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Отмена" Command="{Binding CancelCommand}" Width="160" Height="46" FontSize="18">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#7F7F7F"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>





