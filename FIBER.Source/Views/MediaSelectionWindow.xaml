<Window x:Class="FIBER.Source.Views.MediaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FIBER.Source.Views.Search"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Resources/FIBERLogo.png">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Border Background="#E8171717" CornerRadius="15"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Text="{Binding Title}"
                           FontFamily="Times New Roman" FontSize="22" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,15"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Список медиа с вкладками по типам -->
                <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель управления списком -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Медиафайлы" Foreground="White"
                                       FontFamily="Times New Roman" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Все" Command="{Binding SelectAllCommand}"
                                    Height="28" Padding="10,4" Margin="0,0,6,0"
                                    Background="#3498DB" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Ничего" Command="{Binding DeselectAllCommand}"
                                    Height="28" Padding="10,4"
                                    Background="#7F7F7F" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- Вкладки по типам медиа (единый стиль из App.xaml) -->
                        <TabControl Grid.Row="1" Style="{StaticResource MediaTabControlStyle}">
                            <TabItem Header="Фото" Style="{StaticResource MediaTabItemStyle}"
                                     Visibility="{Binding HasPhotos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PhotoItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A2A" CornerRadius="8" Padding="3" Margin="5"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Width="220" Height="240"
                                                        MouseLeftButtonDown="PhotoBorder_MouseLeftButtonDown">
                                                    <StackPanel>
                                                        <Border Background="#0A000000" CornerRadius="4" ClipToBounds="True"
                                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                Width="200" Height="150" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Image Source="{Binding ImageSource}" Stretch="Uniform">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsImage}" Value="True"/>
                                                                                        <Condition Binding="{Binding LoadFailed}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                    </Image>

                                                                    <!-- Загрузка -->
                                                                    <TextBlock Text="Загрузка…" Foreground="#AAAAAA" FontSize="10"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsImage}" Value="True"/>
                                                                                            <Condition Binding="{Binding IsImageLoading}" Value="True"/>
                                                                                            <Condition Binding="{Binding ImageSource}" Value="{x:Null}"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <!-- Ошибка загрузки -->
                                                                    <TextBlock Text="Ошибка загрузки" Foreground="#FF6666" FontSize="10"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Имя + чекбокс -->
                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                       Foreground="White" FontFamily="Times New Roman"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                      Width="20" Height="20"
                                                                      VerticalAlignment="Center"
                                                                      Margin="6,0,0,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Видео" Style="{StaticResource MediaTabItemStyle}"
                                     Visibility="{Binding HasVideos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding VideoItems}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1C40F" CornerRadius="8" Padding="3" Margin="5"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Width="230" Height="230"
                                                        MouseLeftButtonDown="VideoBorder_MouseLeftButtonDown">
                                                    <StackPanel VerticalAlignment="Top">
                                                        <local:VideoPlayerControl FilePath="{Binding FilePath}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="Black" FontFamily="Times New Roman"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                  Width="20" Height="20"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Аудио" Style="{StaticResource MediaTabItemStyle}"
                                     Visibility="{Binding HasAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding AudioItems}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1F4E79" CornerRadius="8" Padding="3" Margin="5"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Width="230" Height="140">
                                                    <StackPanel VerticalAlignment="Top">
                                                        <local:AudioPlayerControl FilePath="{Binding FilePath}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                  Width="20" Height="20"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <!-- Пустое состояние -->
                        <TextBlock Grid.Row="1" Text="Нет медиафайлов" Foreground="#888888"
                                   FontFamily="Times New Roman" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            Width="120" Height="38" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Background" Value="#7F7F7F"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Добавить" Command="{Binding AddCommand}"
                            Width="160" Height="38"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
