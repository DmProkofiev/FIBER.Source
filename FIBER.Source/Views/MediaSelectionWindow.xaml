<Window x:Class="FIBER.Source.Views.MediaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:FIBER.Source.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Resources/FIBERLogo.png">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Border Background="#E8171717" CornerRadius="15"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Title}"
                           FontFamily="Times New Roman" FontSize="22" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,15"
                           TextTrimming="CharacterEllipsis"/>

                <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Медиафайлы" Foreground="White"
                                       FontFamily="Times New Roman" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Все" Command="{Binding SelectAllCommand}"
                                    Height="26" Padding="10,2" Margin="0,0,6,0"
                                    Background="#3498DB" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Ничего" Command="{Binding DeselectAllCommand}"
                                    Height="26" Padding="10,2"
                                    Background="#7F7F7F" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TabControl Background="Transparent" BorderThickness="0">
                                <TabItem Header="Фото" IsEnabled="{Binding HasPhotos}">
                                    <ItemsControl ItemsSource="{Binding PhotoItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#11FFFFFF" CornerRadius="8" Padding="6"
                                                        Width="200" Height="220" Margin="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Background="#0A000000" CornerRadius="4"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding ImageSource}" Stretch="UniformToFill">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <TextBlock Text="Загрузка…" Foreground="#AAAAAA" FontSize="10"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsImage}" Value="True"/>
                                                                                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}"/>
                                                                                <DataTrigger Binding="{Binding IsImageLoading}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="Ошибка загрузки" Foreground="#FF6666" FontSize="10"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   HorizontalAlignment="Center"/>
                                                        <CheckBox Grid.Row="1" IsChecked="{Binding IsSelected}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                  Margin="6,6,6,0" Width="20" Height="20"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </TabItem>
                                <TabItem Header="Видео" IsEnabled="{Binding HasVideos}">
                                    <ItemsControl ItemsSource="{Binding VideoItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#11FFFFFF" CornerRadius="8" Padding="6"
                                                        Width="200" Height="220" Margin="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Background="Black" CornerRadius="4"
                                                                ClipToBounds="True">
                                                            <helpers:VideoSurface Player="{Binding Player}"/>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   HorizontalAlignment="Center"/>
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" Margin="0,6,0,0">
                                                            <Button Content="▶" Command="{Binding PlayCommand}"
                                                                    Width="26" Height="26" Margin="0,0,4,0"
                                                                    Background="#27AE60" Foreground="White"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    FontWeight="Bold"/>
                                                            <Button Content="❚❚" Command="{Binding PauseCommand}"
                                                                    Width="26" Height="26" Margin="0,0,4,0"
                                                                    Background="#F39C12" Foreground="White"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    FontWeight="Bold"/>
                                                            <Button Content="■" Command="{Binding StopCommand}"
                                                                    Width="26" Height="26"
                                                                    Background="#E74C3C" Foreground="White"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                  Margin="6,6,6,0" Width="20" Height="20"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </TabItem>
                                <TabItem Header="Аудио" IsEnabled="{Binding HasAudios}">
                                    <ItemsControl ItemsSource="{Binding AudioItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#11FFFFFF" CornerRadius="8" Padding="6"
                                                        Width="200" Height="220" Margin="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Background="#27AE60" CornerRadius="4">
                                                            <TextBlock Text="🎵" Foreground="White" FontSize="48"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   HorizontalAlignment="Center"/>
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" Margin="0,6,0,0">
                                                            <Button Content="▶" Command="{Binding PlayCommand}"
                                                                    Width="26" Height="26" Margin="0,0,4,0"
                                                                    Background="#27AE60" Foreground="White"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    FontWeight="Bold"/>
                                                            <Button Content="❚❚" Command="{Binding PauseCommand}"
                                                                    Width="26" Height="26" Margin="0,0,4,0"
                                                                    Background="#F39C12" Foreground="White"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    FontWeight="Bold"/>
                                                            <Button Content="■" Command="{Binding StopCommand}"
                                                                    Width="26" Height="26"
                                                                    Background="#E74C3C" Foreground="White"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                  Margin="6,6,6,0" Width="20" Height="20"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </TabItem>
                            </TabControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1" Text="Нет медиафайлов" Foreground="#888888"
                                   FontFamily="Times New Roman" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Добавить" Command="{Binding AddCommand}"
                            Width="160" Height="38" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            Width="110" Height="38"
                            Background="#7F7F7F" Foreground="White"
                            FontFamily="Times New Roman" FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
