<Window x:Class="FIBER.Source.Views.MediaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Resources/FIBERLogo.png">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Border Background="#E8171717" CornerRadius="15"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Text="{Binding Title}"
                           FontFamily="Times New Roman" FontSize="22" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,15"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Список медиа с вкладками по типам -->
                <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель управления списком -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Медиафайлы" Foreground="White"
                                       FontFamily="Times New Roman" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Все" Command="{Binding SelectAllCommand}"
                                    Height="28" Padding="10,4" Margin="0,0,6,0"
                                    Background="#3498DB" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Ничего" Command="{Binding DeselectAllCommand}"
                                    Height="28" Padding="10,4"
                                    Background="#7F7F7F" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- Вкладки по типам медиа (единый стиль из App.xaml) -->
                        <TabControl Grid.Row="1" Style="{StaticResource MediaTabControlStyle}">
                            <TabItem Header="Фото" Style="{StaticResource MediaTabItemStyle}"
                                     Visibility="{Binding HasPhotos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PhotoItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MediaImageCardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Превью изображения -->
                                                        <Border Grid.Row="0" Background="#0A000000" CornerRadius="4"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding ImageSource}" Stretch="UniformToFill">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsImage}" Value="True"/>
                                                                                        <Condition Binding="{Binding LoadFailed}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>

                                                                <!-- Загрузка -->
                                                                <TextBlock Text="Загрузка…" Foreground="#AAAAAA" FontSize="10"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsImage}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsImageLoading}" Value="True"/>
                                                                                        <Condition Binding="{Binding ImageSource}" Value="{x:Null}"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Ошибка загрузки -->
                                                                <TextBlock Text="Ошибка загрузки" Foreground="#FF6666" FontSize="10"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LoadFailed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Имя + чекбокс -->
                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                       Foreground="White" FontFamily="Times New Roman"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                      Width="20" Height="20"
                                                                      VerticalAlignment="Center"
                                                                      Margin="6,0,0,0"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Видео" Style="{StaticResource MediaTabItemStyle}"
                                     Visibility="{Binding HasVideos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Список видео (единый стиль, кнопки справа) -->
                                <ListBox ItemsSource="{Binding VideoItems}" Margin="0,5,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaVideoCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Плеер видео -->
                                                    <Border Grid.Row="0" Background="#000000" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <MediaElement x:Name="VideoPlayer"
                                                                          Source="{Binding FilePath}"
                                                                          LoadedBehavior="Manual"
                                                                          Stretch="Uniform"
                                                                          Margin="0"/>
                                                            <!-- Кнопки управления справа внизу, не закрывают обзор -->
                                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                        Margin="10,0,10,10" Orientation="Horizontal">
                                                                <Button Content="Play" Style="{StaticResource MediaPlayButtonStyle}"
                                                                        Command="{Binding PlayCommand}"/>
                                                                <Button Content="Pause" Style="{StaticResource MediaPauseButtonStyle}"
                                                                        Command="{Binding PauseCommand}"/>
                                                                <Button Content="Stop" Style="{StaticResource MediaStopButtonStyle}"
                                                                        Command="{Binding StopCommand}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя файла + чекбокс -->
                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                  Width="20" Height="20"
                                                                  VerticalAlignment="Center"
                                                                  Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>

                            <TabItem Header="Аудио" Style="{StaticResource MediaTabItemStyle}"
                                     Visibility="{Binding HasAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Список аудио (красивый контейнер с наименованием и кнопками как в видео) -->
                                <ListBox ItemsSource="{Binding AudioItems}" Margin="0,5,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaAudioCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Контейнер аудиоплеера -->
                                                    <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <MediaElement x:Name="AudioPlayer"
                                                                          Source="{Binding FilePath}"
                                                                          LoadedBehavior="Manual"
                                                                          Stretch="None"
                                                                          Margin="0"/>
                                                            <!-- Кнопки управления справа внизу, как в видео -->
                                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                        Margin="10,0,10,10" Orientation="Horizontal">
                                                                <Button Content="Play" Style="{StaticResource MediaPlayButtonStyle}"
                                                                        Command="{Binding PlayCommand}"/>
                                                                <Button Content="Пауза" Style="{StaticResource MediaPauseButtonStyle}"
                                                                        Command="{Binding PauseCommand}"/>
                                                                <Button Content="Стоп" Style="{StaticResource MediaStopButtonStyle}"
                                                                        Command="{Binding StopCommand}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя файла + чекбокс -->
                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                  Width="20" Height="20"
                                                                  VerticalAlignment="Center"
                                                                  Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>

                        <!-- Пустое состояние -->
                        <TextBlock Grid.Row="1" Text="Нет медиафайлов" Foreground="#888888"
                                   FontFamily="Times New Roman" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            Width="120" Height="38" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Background" Value="#7F7F7F"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Добавить" Command="{Binding AddCommand}"
                            Width="160" Height="38"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
