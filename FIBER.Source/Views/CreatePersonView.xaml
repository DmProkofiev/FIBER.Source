<UserControl x:Class="FIBER.Source.Views.CreatePersonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#D8171717" CornerRadius="15" Margin="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Создание личности"
                       FontFamily="Times New Roman" FontSize="28" FontWeight="Bold"
                       Foreground="White" Margin="30,20,30,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,15,0" Padding="30,5,10,20">
                <StackPanel MaxWidth="800">

                    <Border Background="#22FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Тип объекта:" FontFamily="Times New Roman" FontSize="15"
                                       FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <RadioButton Content="Идентифицированная" Foreground="White"
                                         FontFamily="Times New Roman" FontSize="15" FontWeight="Bold"
                                         VerticalAlignment="Center" Margin="0,0,15,0"
                                         GroupName="PersonType"
                                         IsChecked="{Binding IsIdentifiedMode, Mode=OneWay}"/>
                            <RadioButton Content="Не идентифицированная" Foreground="White"
                                         FontFamily="Times New Roman" FontSize="15" FontWeight="Bold"
                                         VerticalAlignment="Center"
                                         GroupName="PersonType"
                                         IsChecked="{Binding IsAnonymousMode}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIdentifiedMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата рождения:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <DatePicker SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ModernDatePickerStyle}"/>
                                    <TextBlock Text="Сведения отсутствуют"
                                               Foreground="#AAAAAA" FontSize="11" FontStyle="Italic"
                                               Margin="2,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BirthDate}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Паспорт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding Passport, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnonymousMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Псевдоним *:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding PrimaryAlias, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Профессия:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Job, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Телефон:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Город:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Страна:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <ComboBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding Countries}" SelectedValue="{Binding CountryCode}"
                                  SelectedValuePath="Code" DisplayMemberPath="NameRu"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Транспорт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Car, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Email:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="Соцсети:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="16" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SocialMedia, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Адрес:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                        <TextBox Grid.Row="18" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Заметки:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                        <TextBox Grid.Row="20" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </Grid>

                    <Border Margin="0,20,0,0" Height="110" CornerRadius="8"
                            BorderBrush="#55000000" BorderThickness="2" Background="#33FFFFFF"
                            AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                        <Grid>
                            <TextBlock Text="Перетащите сюда изображения или файлы для прикрепления"
                                       FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5">
                                <ItemsControl ItemsSource="{Binding TempFiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="90" Height="90" Margin="5">
                                                <Border CornerRadius="4" ClipToBounds="True" Background="#DDDDDD" ToolTip="{Binding FileName}">
                                                    <Grid>
                                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Padding="5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveTempFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Width="22" Height="22" Background="#CCFF0000" Foreground="White"
                                                        BorderThickness="0" Margin="0,-5,-5,0"
                                                        Template="{StaticResource CloseButtonTemplate}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Button Content="Создать"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Width="220" Height="46"
                            FontSize="18"
                            Margin="0,25,0,10"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>