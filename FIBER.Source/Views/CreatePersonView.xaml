<UserControl x:Class="FIBER.Source.Views.CreatePersonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FIBER.Source.ViewModels"
             xmlns:helpers="clr-namespace:FIBER.Source.Models.Helpers"
             xmlns:local="clr-namespace:FIBER.Source.Views">

    <Border Background="#D8171717" CornerRadius="15" Margin="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Создание личности"
                       FontFamily="Times New Roman" FontSize="28" FontWeight="Bold"
                       Foreground="White" Margin="30,20,30,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,15,0" Padding="30,5,10,20">
                <StackPanel MaxWidth="800">

                    <Border Background="#22FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Тип объекта:" FontFamily="Times New Roman" FontSize="15"
                                       FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <RadioButton Content="Идентифицированная" Foreground="White"
                                         FontFamily="Times New Roman" FontSize="15" FontWeight="Bold"
                                         VerticalAlignment="Center" Margin="0,0,15,0"
                                         GroupName="PersonType"
                                         IsChecked="{Binding IsIdentifiedMode, Mode=OneWay}"/>
                            <RadioButton Content="Не идентифицированная" Foreground="White"
                                         FontFamily="Times New Roman" FontSize="15" FontWeight="Bold"
                                         VerticalAlignment="Center"
                                         GroupName="PersonType"
                                         IsChecked="{Binding IsAnonymousMode}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIdentifiedMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата рождения:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <DatePicker SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ModernDatePickerStyle}"/>
                                    <TextBlock Text="Сведения отсутствуют"
                                               Foreground="#AAAAAA" FontSize="11" FontStyle="Italic"
                                               Margin="2,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BirthDate}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Паспорт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding Passport, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnonymousMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Псевдоним *:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding PrimaryAlias, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Пол:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding GenderChoices}"
                                  SelectedValue="{Binding SelectedGender}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Display"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Профессия:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Job, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Телефон:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Город:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Страна:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <ComboBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding Countries}" SelectedValue="{Binding CountryCode}"
                                  SelectedValuePath="Code" DisplayMemberPath="NameRu"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Транспорт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Car, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Email:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="Соцсети:" Style="{StaticResource FormLabelStyle}" Margin="0,0,15,0"/>
                        <TextBox Grid.Row="16" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SocialMedia, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Адрес:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                        <TextBox Grid.Row="18" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Заметки:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                        <TextBox Grid.Row="20" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalAlignment="Stretch"/>
                    </Grid>

                    <!-- ================= СВЯЗИ С ПЕРСОНАМИ ================= -->
                    <Expander Header="Связи с персонами" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailablePersons}"
                                          SelectedValue="{Binding SelectedRelatedPersonId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"/>
                                <Button Grid.Column="1" Content="Добавить"
                                        Command="{Binding AddRelationshipCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonGreen}"
                                        BorderThickness="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Relationships}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True"
                                                         Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                                      ItemsSource="{x:Static helpers:PersonRelationKinds.AllOptions}"
                                                      SelectedValue="{Binding Kind}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Display"
                                                      Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,6,0"/>
                                                <Button Grid.Column="3" Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveRelationshipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Связи не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Relationships.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- ================= СВЯЗИ С ОРГАНИЗАЦИЯМИ ================= -->
                    <Expander Header="Связи с организациями" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableCompanies}"
                                          SelectedValue="{Binding SelectedTargetCompanyId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"/>
                                <Button Grid.Column="1" Content="Добавить"
                                        Command="{Binding AddCompanyPersonCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonGreen}"
                                        BorderThickness="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CompanyPeople}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="Персона" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding CompanyName, Mode=OneWay}" IsReadOnly="True"
                                                         Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,6"/>
                                                
                                                <TextBlock Text="Роль" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                         Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,0,6"/>
                                                
                                                <TextBlock Text="Заметки" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,6"/>
                                                
                                                <Button Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveCompanyPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Связи с организациями не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompanyPeople.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- ================= СВЯЗИ С СОБЫТИЯМИ ================= -->
                    <Expander Header="Связи с событиями" IsExpanded="True" Margin="0,20,0,0"
                              FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                              Foreground="White" Background="#22FFFFFF" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableEvents}"
                                          SelectedValue="{Binding SelectedTargetEventId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Title"/>
                                <Button Grid.Column="1" Content="Добавить"
                                        Command="{Binding AddEventParticipationCommand}"
                                        HorizontalAlignment="Right" Height="30" Padding="12,4" Margin="8,0,0,0"
                                        Style="{StaticResource ActionButtonGreen}"
                                        BorderThickness="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding EventParticipations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True"
                                                         Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                                          ItemsSource="{x:Static helpers:EventParticipantRoles.AllOptions}"
                                                          SelectedValue="{Binding Role}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Display"
                                                          Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,6,0"/>
                                                <Button Grid.Column="3" Content="×" Width="26" Height="26"
                                                        Background="#CCFF0000" Foreground="White" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveEventParticipationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Связи с событиями не добавлены" Foreground="#888888"
                                       FontFamily="Times New Roman" FontSize="13" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EventParticipations.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <Border Margin="0,20,0,0" Height="110" CornerRadius="8"
                            BorderBrush="#55000000" BorderThickness="2" Background="#33FFFFFF"
                            AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                        <Grid>
                            <TextBlock Text="Перетащите сюда изображения или файлы для прикрепления"
                                       FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5">
                                <ItemsControl ItemsSource="{Binding TempFiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="90" Height="90" Margin="5">
                                                <Border CornerRadius="4" ClipToBounds="True" Background="#DDDDDD" ToolTip="{Binding FileName}">
                                                    <Grid>
                                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Padding="5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveTempFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Width="22" Height="22" Background="#CCFF0000" Foreground="White"
                                                        BorderThickness="0" Margin="0,-5,-5,0"
                                                        Template="{StaticResource CloseButtonTemplate}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <local:MediaStorageButton Command="{Binding AddExistingMediaCommand}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,10">
                        <Button Content="Создать"
                                Command="{Binding CreateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="200" Height="46"
                                FontSize="18"
                                Margin="0,0,10,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>