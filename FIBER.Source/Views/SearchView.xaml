<UserControl x:Class="FIBER.Source.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:FIBER.Source.Helpers"
             xmlns:search="clr-namespace:FIBER.Source.Views.Search"
             DataContextChanged="OnDataContextChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Style="{StaticResource MediaTabControlStyle}" SelectedIndex="{Binding SelectedTabIndex}" Margin="30,0,0,0">
            <TabItem Header="Личности" Style="{StaticResource MainTabItemStyle}" Width="75" Margin="0,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="20,20,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Поиск личностей" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" Foreground="White"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Height="32" VerticalAlignment="Center"
                                 Text="{Binding PersonQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding SearchPersonsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" Height="32" Width="90" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="4" Background="#33FFFFFF" CornerRadius="6" Padding="8,6" Height="96">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Стратегия:" Foreground="White" FontFamily="Times New Roman"
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding SearchStrategies}"
                                      SelectedItem="{Binding SelectedStrategy}"
                                      DisplayMemberPath="DisplayName"
                                      Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус:" Foreground="White" FontFamily="Times New Roman"
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      DisplayMemberPath="Display"
                                      Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="6" Background="#66FFFFFF" CornerRadius="8" Padding="4">
                        <ListBox ItemsSource="{Binding PersonResults}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPersonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderBrush="Transparent" Padding="10,8" Margin="2">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AliasCountDisplay}" FontFamily="Times New Roman" FontSize="13" Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BirthDateDisplay, StringFormat='Дата рождения: {0}'}" FontFamily="Times New Roman" FontSize="13" Foreground="#333333" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding StatusDisplay, StringFormat='Статус: {0}'}" FontFamily="Times New Roman" FontSize="12" Foreground="#5A5A5A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Margin="0,20,20,20" Background="#66FFFFFF" CornerRadius="10" Padding="4">
                    <search:EntityDetailsPanel
                        EntityDisplayName="{Binding SelectedEntityDisplayName}"
                        Fields="{Binding SelectedEntityFields}"
                        Relations="{Binding SelectedEntityRelations}"
                        Images="{Binding PersonImages}"
                        Videos="{Binding PersonVideos}"
                        Audio="{Binding PersonAudio}"
                        HasSelection="{Binding HasPersonSelection}"
                        NavigationHistoryCount="{Binding NavigationHistoryCount}"
                        EditCommand="{Binding UpdatePersonCommand}"
                        DeleteCommand="{Binding DeletePersonCommand}"
                        ExportCommand="{Binding ExportPersonCommand}"
                        DuplicatesCommand="{Binding ShowDuplicatesCommand}"
                        ClearCommand="{Binding ClearPersonSelectionCommand}"
                        NavigateBackCommand="{Binding NavigateBackCommand}"/>
                </Border>
            </Grid>
        </TabItem>

            <TabItem Header="Организации" Style="{StaticResource MainTabItemStyle}" Width="100" Margin="0,0,2,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="280"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="20,20,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Поиск организаций" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" Foreground="White"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Height="32" VerticalAlignment="Center"
                                 Text="{Binding CompanyQuery, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Найти" Command="{Binding SearchCompaniesCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" Height="32" Width="90" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="4" Background="#66FFFFFF" CornerRadius="8" Padding="4" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding CompanyResults}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectCompanyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderBrush="Transparent" Padding="10,8" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RegistrationNumber, StringFormat='Рег. номер: {0}', TargetNullValue='Рег. номер: Сведения отсутствуют'}" FontFamily="Times New Roman" FontSize="13" Foreground="#333333" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Margin="0,20,20,20" Background="#66FFFFFF" CornerRadius="10" Padding="4">
                        <search:EntityDetailsPanel
                        EntityDisplayName="{Binding SelectedEntityDisplayName}"
                        Fields="{Binding SelectedEntityFields}"
                        Relations="{Binding SelectedEntityRelations}"
                        Images="{Binding CompanyImages}"
                        Videos="{Binding CompanyVideos}"
                        Audio="{Binding CompanyAudio}"
                        HasSelection="{Binding HasCompanySelection}"
                        NavigationHistoryCount="{Binding NavigationHistoryCount}"
                        EditCommand="{Binding UpdateCompanyCommand}"
                        DeleteCommand="{Binding DeleteCompanyCommand}"
                        ExportCommand="{Binding ExportCompanyCommand}"
                        DuplicatesCommand="{x:Null}"
                        ClearCommand="{Binding ClearCompanySelectionCommand}"
                        NavigateBackCommand="{Binding NavigateBackCommand}"/>
                    </Border>
                </Grid>
            </TabItem>
            
            <TabItem Header="События" Style="{StaticResource MainTabItemStyle}" Width="78">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0" Margin="20,20,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Поиск событий" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" Foreground="White"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Height="32" VerticalAlignment="Center"
                                 Text="{Binding EventQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding SearchEventsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" Height="32" Width="90" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="4" Background="#66FFFFFF" CornerRadius="8" Padding="4" Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding EventResults}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderBrush="Transparent" Padding="10,8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DateDisplay, StringFormat='Дата: {0}'}" FontFamily="Times New Roman" FontSize="13" Foreground="#333333" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding OrganizerDisplay, StringFormat='Организатор: {0}'}" FontFamily="Times New Roman" FontSize="12" Foreground="#5A5A5A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Margin="0,20,20,20" Background="#66FFFFFF" CornerRadius="10" Padding="4">
                    <search:EntityDetailsPanel
                        EntityDisplayName="{Binding SelectedEntityDisplayName}"
                        Fields="{Binding SelectedEntityFields}"
                        Relations="{Binding SelectedEntityRelations}"
                        Images="{Binding EventImages}"
                        Videos="{Binding EventVideos}"
                        Audio="{Binding EventAudio}"
                        HasSelection="{Binding HasEventSelection}"
                        NavigationHistoryCount="{Binding NavigationHistoryCount}"
                        EditCommand="{Binding UpdateEventCommand}"
                        DeleteCommand="{Binding DeleteEventCommand}"
                        ExportCommand="{Binding ExportEventCommand}"
                        DuplicatesCommand="{x:Null}"
                        ClearCommand="{Binding ClearEventSelectionCommand}"
                        NavigateBackCommand="{Binding NavigateBackCommand}"/>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
    </Grid>
</UserControl>
