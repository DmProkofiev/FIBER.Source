<UserControl x:Class="FIBER.Source.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:FIBER.Source.Helpers"
             PreviewKeyDown="SearchView_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">

        <!-- ================= ЛИЧНОСТИ ================= -->
        <TabItem Header="Личности">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="20,20,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Поиск личностей" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" Foreground="White"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Height="32" VerticalAlignment="Center"
                                 Text="{Binding PersonQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding SearchPersonsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" Height="32" Width="90" Padding="0" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="4" Background="#33FFFFFF" CornerRadius="6" Padding="8,6" Height="96">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Стратегия:" Foreground="White" FontFamily="Times New Roman"
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding SearchStrategies}"
                                      SelectedItem="{Binding SelectedStrategy}"
                                      DisplayMemberPath="DisplayName"
                                      Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус:" Foreground="White" FontFamily="Times New Roman"
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      DisplayMemberPath="Display"
                                      Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="6" Background="#66FFFFFF" CornerRadius="8" Padding="4">
                        <ListBox ItemsSource="{Binding PersonResults}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPersonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderBrush="Transparent" Padding="10,8" Margin="2">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AliasCountDisplay}" FontFamily="Times New Roman" FontSize="13" Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BirthDateDisplay, StringFormat='Дата рождения: {0}'}" FontFamily="Times New Roman" FontSize="13" Foreground="#333333" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding StatusDisplay, StringFormat='Статус: {0}'}" FontFamily="Times New Roman" FontSize="12" Foreground="#5A5A5A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Margin="0,20,20,20" Background="#66FFFFFF" CornerRadius="10" Padding="4">
                    <Grid>
                        <TextBlock Text="Выберите запись в списке" FontFamily="Times New Roman" FontSize="18" Foreground="#5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPersonSelection}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPersonSelection}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedPersonDisplayName}" FontFamily="Times New Roman" FontSize="22" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Редактировать" Command="{Binding UpdatePersonCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,4" FontSize="14" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Дубликаты" Click="DuplicatesPerson_Click" Height="34" Padding="14,4" FontSize="14" VerticalAlignment="Center"
                                        Background="#3498DB" Foreground="White" FontFamily="Times New Roman" FontWeight="Bold" Cursor="Hand" BorderBrush="Transparent"
                                        Template="{StaticResource ActionButtonTemplate}">
                                </Button>
                                <Button Grid.Column="5" Content="Экспорт" Click="ExportPerson_Click" Height="34" Padding="14,4" FontSize="14" VerticalAlignment="Center"
                                        Background="#16A085" Foreground="White" FontFamily="Times New Roman" FontWeight="Bold" Cursor="Hand" BorderBrush="Transparent"
                                        Template="{StaticResource ActionButtonTemplate}">
                                </Button>
                                <Button Grid.Column="7" Content="Удалить" Command="{Binding DeletePersonCommand}" Height="34" Padding="14,4" FontSize="14" VerticalAlignment="Center"
                                        Background="#E74C3C" Foreground="White" FontFamily="Times New Roman" FontWeight="Bold" Cursor="Hand" BorderBrush="Transparent"
                                        Template="{StaticResource ActionButtonTemplate}">
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="ID" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Id, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.BirthDateDisplay, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Пол" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.GenderDisplay, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Паспорт" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Passport, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Профессия" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Job, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Телефон" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Phone, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Город" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.City, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Страна" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPersonCountryName, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Транспорт" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Car, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Mail, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Соцсети" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.SocialMedia, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Адрес" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Address, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Заметки" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SelectedPerson.Notes, TargetNullValue='Сведения отсутствуют', Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Псевдонимы" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding SelectedPerson.Aliases}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="●" Foreground="#27AE60" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="—">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValueStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPerson.Aliases.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Связи" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding PersonRelations}" ItemTemplate="{StaticResource RelationItemTemplate}"/>
                                            <TextBlock Text="Связи отсутствуют" Foreground="#888888" FontFamily="Times New Roman" FontSize="15" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PersonRelations.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

<Border Style="{StaticResource FieldCardStyle}" Margin="0,15,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Медиафайлы" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10"/>
                                            <TabControl Style="{StaticResource MediaTabControlStyle}">
                                                <TabItem Header="Фото" Style="{StaticResource MediaTabItemStyle}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding PersonImages}" Margin="0,5,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="3"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Height="220" Width="220" Margin="5"
                                                                            CornerRadius="8" ClipToBounds="True" Background="#222222"
                                                                            Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                                                            Tag="Person">
                                                                        <Grid>
                                                                            <Image Source="{Binding ImageSource}" Stretch="Uniform">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                            <TextBlock Text="Загрузка…" Foreground="#AAA" FontSize="10"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsImageLoading}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </TabItem>
                                                <TabItem Header="Видео" Style="{StaticResource MediaTabItemStyle}">
                                                    <ListBox ItemsSource="{Binding PersonVideos}" Margin="0,5,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaVideoCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Плеер видео -->
                                                    <Border Grid.Row="0" Background="#000000" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <MediaElement Source="{Binding FilePath}"
                                                                          LoadedBehavior="Manual"
                                                                          Stretch="Uniform"
                                                                          Margin="0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя файла -->
                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                                </TabItem>
                                                <TabItem Header="Аудио" Style="{StaticResource MediaTabItemStyle}">
                                                    <ListBox ItemsSource="{Binding PersonAudio}" Margin="0,5,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MediaAudioCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Контейнер аудиоплеера -->
                                                    <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <MediaElement Source="{Binding FilePath}"
                                                                          LoadedBehavior="Manual"
                                                                          Stretch="None"
                                                                          Margin="0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Имя файла -->
                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                   Foreground="White" FontFamily="Times New Roman"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                                </TabItem>
                                            </TabControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="Отменить" Command="{Binding ClearPersonSelectionCommand}"
            Height="30" Padding="14,4"
            FontFamily="Times New Roman" FontSize="13" FontWeight="Bold"
            Background="#33FFFFFF" BorderBrush="#55000000" BorderThickness="1"
            Cursor="Hand"/>
                                    <Button Content="Назад" Command="{Binding NavigateBackCommand}"
            Height="30" Padding="14,4"
            FontFamily="Times New Roman" FontSize="13" FontWeight="Bold"
            Background="#33FFFFFF" BorderBrush="#55000000" BorderThickness="1"
            Cursor="Hand"
            Margin="8,0,0,0"
            Visibility="{Binding NavigationHistoryCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ================= ОРГАНИЗАЦИИ ================= -->
        <TabItem Header="Организации">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="20,20,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Поиск организаций" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" Foreground="White"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Height="32" VerticalAlignment="Center"
                                 Text="{Binding CompanyQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding SearchCompaniesCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" Height="32" Width="90" Padding="0" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="4" Background="#66FFFFFF" CornerRadius="8" Padding="4" Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding CompanyResults}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectCompanyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderBrush="Transparent" Padding="10,8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RegistrationNumber, StringFormat='Рег. номер: {0}', TargetNullValue='Рег. номер: Сведения отсутствуют'}" FontFamily="Times New Roman" FontSize="13" Foreground="#333333" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Margin="0,20,20,20" Background="#66FFFFFF" CornerRadius="10" Padding="4">
                    <Grid>
                        <TextBlock Text="Выберите запись в списке" FontFamily="Times New Roman" FontSize="18" Foreground="#5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCompanySelection}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCompanySelection}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
