<Window x:Class="FIBER.Source.Views.IdentificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIBER Source"
        Height="600" Width="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/FIBERLogo.png">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/BackGround.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="#D8171717" CornerRadius="30" Margin="35,30,35,30" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="/Resources/FIBERLogo.png" Width="140" Height="140"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="FIBER Source"
                               FontFamily="Times New Roman" FontSize="28" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <TextBlock Text="Файл данных:" Foreground="#CCCCCC"
                               FontFamily="Times New Roman" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DatabaseDisplayPath}" Foreground="White"
                               FontFamily="Times New Roman" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,12"/>

                    <Border Background="#22FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                        <TextBlock FontFamily="Times New Roman" FontSize="13" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Вход в существующую базу"/>
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewDatabase}" Value="True">
                                            <Setter Property="Text" Value="Будет создана новая база данных"/>
                                            <Setter Property="Foreground" Value="#F39C12"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Мастер-пароль:" Foreground="White"
                               FontFamily="Times New Roman" FontSize="15" FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="35" Padding="8"
                                 FontFamily="Times New Roman" FontSize="18" FontWeight="Bold"
                                 Background="#E8FFFFFF" Foreground="Black"
                                 BorderBrush="#55000000" BorderThickness="1"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C"
                               FontFamily="Times New Roman" FontSize="13" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,10,0,5"/>

                    <Button Content="{Binding LoginButtonText}"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42" Margin="0,10,0,0"
                            FontSize="18" IsDefault="True"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>