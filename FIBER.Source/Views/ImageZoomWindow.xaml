<Window x:Class="FIBER.Source.Views.ImageZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр" WindowState="Maximized" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent" 
        KeyDown="Window_KeyDown">

    <Grid Background="#CC000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" Background="#88000000" Padding="10">
            <Grid>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Колесико: зум | Мышь: перемещение | Стрелки: листать | Esc: закрыть" Foreground="Gray" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="×" Width="40" Height="40" FontSize="20" Click="Close_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Область просмотра -->
        <Grid Grid.Row="1" x:Name="ZoomContainer" ClipToBounds="True" Background="Transparent">

            <!-- 1. Картинка (в самом низу, чтобы кнопки были сверху) -->
            <Image x:Name="ZoomImage" Stretch="Uniform" 
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0,0"
                   MouseWheel="Image_MouseWheel"
                   MouseLeftButtonDown="Image_MouseLeftButtonDown"
                   MouseLeftButtonUp="Image_MouseLeftButtonUp"
                   MouseMove="Image_MouseMove"
                   LostMouseCapture="Image_LostMouseCapture"
                   Cursor="SizeAll">
                <Image.RenderTransform>
                    <TransformGroup>
                        <!-- Порядок важен: сначала масштабирование, затем перемещение -->
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- 2. Кнопки навигации (сверху над картинкой) -->
            <Button x:Name="PrevButton" Content="&lt;" Click="Prev_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="60" Height="100" Margin="20,0,0,0"
                    Background="#55000000" Foreground="White" FontSize="40"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="NextButton" Content=">" Click="Next_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="60" Height="100" Margin="0,0,20,0"
                    Background="#55000000" Foreground="White" FontSize="40"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Grid>
</Window>