<Window x:Class="FIBER.Source.Views.RelationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Связи" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#1F1F1F">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Border Background="#D8171717" CornerRadius="15" Margin="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Управление связями" FontFamily="Times New Roman" FontSize="28" FontWeight="Bold"
                       Foreground="White" Margin="30,20,30,10"/>

            <TabControl Grid.Row="1" Margin="30,10,30,10" Background="Transparent" BorderThickness="0">

                <TabItem Header="Участие в событиях" Visibility="{Binding ShowPersonTabs, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Событие:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Роль:" Foreground="White"/>
                                <ComboBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AllEvents}" SelectedValue="{Binding SelectedEventId}"
                                          SelectedValuePath="Id" DisplayMemberPath="Title" Margin="0,0,5,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                                          DisplayMemberPath="Display"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Добавить"
                                        Command="{Binding AddEventParticipationCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="12,0" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="8">
                            <ListView ItemsSource="{Binding EventParticipations}" Background="Transparent" BorderThickness="0" Foreground="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="400"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Event.Title}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveEventParticipationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Отношения" Visibility="{Binding ShowPersonTabs, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Связанная персона:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Тип связи:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Заметки:" Foreground="White"/>
                                <ComboBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AllPersons}" SelectedValue="{Binding SelectedRelatedPersonId}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName" Margin="0,0,5,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                                          DisplayMemberPath="Display" Margin="0,0,5,0"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding RelationNotes, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Row="2" Grid.Column="3" Content="Добавить"
                                        Command="{Binding AddPersonRelationshipCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="12,0" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="8">
                            <ListView ItemsSource="{Binding Relationships}" Background="Transparent" BorderThickness="0" Foreground="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RelatedPerson.FullName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding KindDisplay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Notes}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="✕" Width="24" Height="24"
                                                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.RemovePersonRelationshipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Взаимодействия" Visibility="{Binding ShowCompanyTabs, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Организация:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Тип:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Заметки:" Foreground="White"/>
                                <ComboBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AllCompanies}" SelectedValue="{Binding SelectedTargetCompanyId}"
                                          SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,5,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding InteractionType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding InteractionNotes, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Row="2" Grid.Column="3" Content="Добавить"
                                        Command="{Binding AddCompanyInteractionCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="12,0" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="8">
                            <ListView ItemsSource="{Binding CompanyInteractions}" Background="Transparent" BorderThickness="0" Foreground="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TargetCompany.Name}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InteractionType}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Notes}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="✕" Width="24" Height="24"
                                                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveCompanyInteractionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Участники" Visibility="{Binding ShowEventTabs, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Персона:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Организация:" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Роль:" Foreground="White"/>
                                <ComboBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AllPersons}" SelectedValue="{Binding ParticipantPersonId}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName" Margin="0,0,5,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AllCompanies}" SelectedValue="{Binding ParticipantCompanyId}"
                                          SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,5,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                                          DisplayMemberPath="Display"/>
                                <Button Grid.Row="2" Grid.Column="3" Content="Добавить"
                                        Command="{Binding AddParticipantToEventCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="12,0" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="8">
                            <ListView ItemsSource="{Binding EventParticipants}" Background="Transparent" BorderThickness="0" Foreground="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="400"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}{1}">
                                                        <Binding Path="Person.FullName" FallbackValue=""/>
                                                        <Binding Path="Company.Name" FallbackValue=""/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveEventParticipationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="Закрыть" Height="40" Width="160" Margin="0,0,0,20"
                    HorizontalAlignment="Center" Click="Close_Click"
                    Background="#7F7F7F" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
