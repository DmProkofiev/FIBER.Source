<UserControl x:Class="FIBER.Source.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Настройки и Информация"
                       FontFamily="Times New Roman" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding AppVersion}" Foreground="#CCCCCC" FontSize="16" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding DbPath, StringFormat='Путь к БД: {0}'}"
                       Foreground="#999999" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#D8171717" CornerRadius="10" Padding="15">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Люди">
                        <ListBox ItemsSource="{Binding People}" Background="Transparent"
                                 BorderThickness="0" Foreground="White" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding BirthDateDisplay, StringFormat='Дата рождения: {0}'}" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding MediaCount, StringFormat='Медиафайлов: {0}'}" FontSize="11" Foreground="#88FFFFFF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Организации">
                        <ListBox ItemsSource="{Binding Companies}" Background="Transparent"
                                 BorderThickness="0" Foreground="White" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding RegistrationNumber, StringFormat='Рег. номер: {0}', TargetNullValue='Рег. номер: Сведения отсутствуют'}" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding MediaCount, StringFormat='Медиафайлов: {0}'}" FontSize="11" Foreground="#88FFFFFF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="События">
                        <ListBox ItemsSource="{Binding Events}" Background="Transparent"
                                 BorderThickness="0" Foreground="White" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DateDisplay, StringFormat='Дата: {0}'}" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBlock Text="{Binding OrganizerCompanyName, StringFormat='Организатор: {0}', TargetNullValue='Организатор: Сведения отсутствуют'}" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Text="{Binding MediaCount, StringFormat='Медиафайлов: {0}'}" FontSize="11" Foreground="#88FFFFFF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Медиафайлы">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="5"
                                    Padding="10,8" Margin="0,10,0,8">
                                <TextBlock Text="{Binding MediaTotal, StringFormat='Всего медиафайлов: {0}'}"
                                           Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AllMedia}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#22FFFFFF" CornerRadius="5"
                                                    Margin="0,0,0,8" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="90" Height="90"
                                                            CornerRadius="4" ClipToBounds="True"
                                                            Background="#222" Margin="0,0,10,0">
                                                        <Grid>
                                                            <Image Source="{Binding Media.ImageSource}" Stretch="UniformToFill">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Media.IsImage}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock Text="[Видео]" Foreground="White" FontSize="13"
                                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Media.IsVideo}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="[Аудио]" Foreground="White" FontSize="13"
                                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Media.IsAudio}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OwnerDisplay}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Media.FileName}" Foreground="#CCC" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Background="#D8171717" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="*"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=LogExpander, Path=IsExpanded}" Value="False">
                                            <Setter Property="Height" Value="Auto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Expander x:Name="LogExpander" Grid.Row="0" IsExpanded="True"
                              Header="Журнал событий"
                              FontFamily="Times New Roman" FontSize="18" FontWeight="Bold"
                              Foreground="White"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                              Background="#11FFFFFF">
                        <ListBox ItemsSource="{Binding Logs}" Background="Transparent"
                                 BorderThickness="0" Foreground="White" Margin="0,8,0,0"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding DisplayAction}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#CCCCCC"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"
                                                   FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>

                    <Expander Grid.Row="1" IsExpanded="False"
                              Header="Смена пароля"
                              FontFamily="Times New Roman" FontSize="18" FontWeight="Bold"
                              Foreground="White" Background="#11FFFFFF" Margin="0,10,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Старый пароль:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,3"/>
                            <PasswordBox x:Name="OldPassBox" PasswordChanged="OldPassBox_PasswordChanged"
                                         Height="30" Margin="0,0,0,8"
                                         Background="#333" Foreground="White" BorderBrush="#555"/>
                            <TextBlock Text="Новый пароль:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,3"/>
                            <PasswordBox x:Name="NewPassBox" PasswordChanged="NewPassBox_PasswordChanged"
                                         Height="30" Margin="0,0,0,8"
                                         Background="#333" Foreground="White" BorderBrush="#555"/>
                            <TextBlock Text="Подтвердите пароль:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,3"/>
                            <PasswordBox x:Name="ConfirmPassBox" PasswordChanged="ConfirmPassBox_PasswordChanged"
                                         Height="30" Margin="0,0,0,10"
                                         Background="#333" Foreground="White" BorderBrush="#555"/>
                            <Button Content="Изменить пароль" Command="{Binding ChangePasswordCommand}"
                                    Height="32" Background="#F39C12" Foreground="White"
                                    FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>
                    </Expander>

                    <Expander Grid.Row="2" IsExpanded="False"
                              Header="Действия с БД"
                              FontFamily="Times New Roman" FontSize="18" FontWeight="Bold"
                              Foreground="White" Background="#11FFFFFF" Margin="0,10,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <Button Content="Экспорт зашифрованного файла"
                                    Command="{Binding ExportEncryptedCommand}"
                                    Height="32" Background="#3498DB" Foreground="White"
                                    FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="0,0,0,8"/>
                            <Button Content="Экспорт расшифрованного файла"
                                    Command="{Binding ExportUnencryptedCommand}"
                                    Height="32" Background="#9B59B6" Foreground="White"
                                    FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                            <Button Content="Создать тестовые данные (100 персон, org, события)"
                                    Command="{Binding SeedDataCommand}"
                                    Height="32" Background="#27AE60" Foreground="White"
                                    FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>