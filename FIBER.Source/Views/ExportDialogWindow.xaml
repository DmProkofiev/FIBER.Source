<Window x:Class="FIBER.Source.Views.ExportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Resources/FIBERLogo.png">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Border Background="#E8171717" CornerRadius="15"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding ObjectTitle}"
                           FontFamily="Times New Roman" FontSize="22" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,15"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Формат:" Foreground="White" FontFamily="Times New Roman"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Content="Word (.docx)" GroupName="fmt"
                                 IsChecked="{Binding IsWordFormat}"
                                 Foreground="White" FontFamily="Times New Roman" FontSize="14"
                                 VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton Content="Текст (.txt)" GroupName="fmt"
                                 IsChecked="{Binding IsTxtFormat}"
                                 Foreground="White" FontFamily="Times New Roman" FontSize="14"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Папка:" Foreground="White" FontFamily="Times New Roman"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Обзор..." Command="{Binding BrowseFolderCommand}"
                            Height="32" Width="100" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                </Grid>

                <Border Grid.Row="3" Background="#22FFFFFF" CornerRadius="8" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Медиафайлы для выгрузки" Foreground="White"
                                       FontFamily="Times New Roman" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Все" Command="{Binding SelectAllCommand}"
                                    Height="26" Padding="10,2" Margin="0,0,6,0"
                                    Background="#3498DB" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Ничего" Command="{Binding DeselectAllCommand}"
                                    Height="26" Padding="10,2"
                                    Background="#7F7F7F" Foreground="White" FontFamily="Times New Roman"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MediaItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="4" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="3"
                                                        Background="#333333" Margin="0,0,10,0" ClipToBounds="True">
                                                    <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                                           Foreground="White" FontFamily="Times New Roman"
                                                           FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TypeLabel}"
                                                           Foreground="#AAAAAA" FontFamily="Times New Roman"
                                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" Text="Нет медиафайлов" Foreground="#888888"
                                   FontFamily="Times New Roman" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Экспортировать" Command="{Binding ExportCommand}"
                            Width="160" Height="38" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            Width="110" Height="38"
                            Background="#7F7F7F" Foreground="White"
                            FontFamily="Times New Roman" FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>