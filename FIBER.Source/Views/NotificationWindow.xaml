<Window x:Class="FIBER.Source.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="480"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Resources/FIBERLogo.png">
    <Grid>
        <Border CornerRadius="15">
            <Border.Background>
                <ImageBrush ImageSource="/Resources/BackGround.png" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <Border Background="#E8171717" CornerRadius="15"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBorder" Grid.Column="0" Width="36" Height="36"
                            CornerRadius="18" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="IconText"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Times New Roman" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="Times New Roman" FontSize="20" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Content="×" Width="28" Height="28"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Click="Close_Click" VerticalAlignment="Top"/>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="420"
                              VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
                    <TextBlock x:Name="MessageText" FontFamily="Times New Roman" FontSize="14"
                               Foreground="#DDDDDD" TextWrapping="Wrap"/>
                </ScrollViewer>

                <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>