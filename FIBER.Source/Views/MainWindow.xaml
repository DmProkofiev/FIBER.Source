<Window x:Class="FIBER.Source.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FIBER Source" Height="700" MinHeight="600" MinWidth="900" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/FIBERLogo.png">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/BackGround.png"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="115"/>
            <RowDefinition Height="10"/>
            <RowDefinition/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <!-- Шапка-кнопка -->
        <Button Grid.Row="1" Grid.Column="1"
                Command="{Binding ShowMenuCommand}"
                Cursor="Hand" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="#D8171717" CornerRadius="30">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Resources/FIBERLogo.png">
                    <Image.Effect>
                        <DropShadowEffect Color="White" BlurRadius="85" ShadowDepth="4"/>
                    </Image.Effect>
                </Image>
                <TextBlock Text="FIBER Source" Foreground="White"
                           FontFamily="Times New Roman" FontSize="55"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Фон панели (только закруглённый прямоугольник) -->
        <Border x:Name="MainBorder"
                Grid.Row="3" Grid.Column="1"
                Background="#D8171717"
                CornerRadius="30"/>

        <!-- Содержимое панели, обрезанное по скруглению MainBorder -->
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=MainBorder}"/>
            </Grid.OpacityMask>
            <ContentControl Content="{Binding CurrentContent}"
                            Style="{StaticResource FadeContentControlStyle}"/>
        </Grid>
    </Grid>
</Window>