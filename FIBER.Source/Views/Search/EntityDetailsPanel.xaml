<UserControl x:Class="FIBER.Source.Views.Search.EntityDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FIBER.Source.Views.Search"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + команды -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding EntityDisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="Times New Roman" FontSize="22" FontWeight="Bold" Foreground="Black"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- Редактировать (зеленый) — виден только при выбранном объекте -->
            <Button Grid.Column="1" Content="Редактировать" Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="110">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonGreen}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Экспорт (бирюзовый) — виден только при выбранном объекте -->
            <Button Grid.Column="3" Content="Экспорт" Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="60">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonTeal}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Удалить (красный) — виден только при выбранном объекте -->
            <Button Grid.Column="5" Content="Удалить" Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="60">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonRed}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Дубликаты (синий) — виден только при выбранном объекте -->
            <Button Grid.Column="7" Content="Дубликаты" Command="{Binding DuplicatesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="80">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBlue}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Сбросить (серый) — всегда виден -->
            <Button Grid.Column="9" Content="Сбросить" Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource ActionButtonGray}" Width="70"/>
        </Grid>

        <!-- Сообщение когда ничего не выбрано -->
        <TextBlock Grid.Row="2" Text="Выберите запись в списке" FontFamily="Times New Roman" FontSize="18" Foreground="#5A5A5A"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Панель деталей -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поля -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Fields, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FieldCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldValueTextBoxStyle}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Связи -->
                    <Border Style="{StaticResource FieldCardStyle}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Связи" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Relations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ItemTemplate="{StaticResource RelationItemTemplate}"/>
                            <TextBlock Text="Связи отсутствуют" Foreground="#888888" FontFamily="Times New Roman" FontSize="15" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Relations.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Медиа -->
                    <Border Style="{StaticResource FieldCardStyle}" Margin="0,15,0,0" Background="#19020202" BorderBrush="{x:Null}">
                        <StackPanel>
                            <TextBlock Text="Медиафайлы" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" Foreground="White"/>
                            <TabControl Style="{StaticResource MediaTabControlStyle}">
                                <TabItem Header="Фото" Style="{StaticResource MediaTabItemStyle}"
                                         Visibility="{Binding Images.Count, Converter={StaticResource PositiveCountToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="#7FF60808">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="150" Foreground="{x:Null}">
                                        <ItemsControl ItemsSource="{Binding Images, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{x:Null}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="220" Width="220" Margin="5"
                                                            CornerRadius="8" ClipToBounds="True" Background="#222222"
                                                            Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown">
                                                        <Grid>
                                                            <Image Source="{Binding ImageSource}" Stretch="Uniform">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock Text="Загрузка…" Foreground="#AAA" FontSize="10"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsImageLoading}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Видео" Style="{StaticResource MediaTabItemStyle}"
                                         Visibility="{Binding Videos.Count, Converter={StaticResource PositiveCountToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" Background="#7FFF0000">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="150" Foreground="{x:Null}" Background="#00000000">
                                        <ItemsControl ItemsSource="{Binding Videos, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{x:Null}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F1C40F" CornerRadius="8" Padding="8" Margin="5"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                                            Width="250" Height="260"
                                                            MouseLeftButtonDown="VideoBorder_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}"
                                                                       Foreground="Black" FontFamily="Times New Roman"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                                       Margin="0,0,0,8"/>
                                                            <local:VideoPlayerControl FilePath="{Binding FilePath}"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Аудио" Style="{StaticResource MediaTabItemStyle}"
                                         Visibility="{Binding Audio.Count, Converter={StaticResource PositiveCountToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" BorderBrush="#54000000" Background="#7FFF0000">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="150" Foreground="{x:Null}">
                                        <ItemsControl ItemsSource="{Binding Audio, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,5,0,0" Foreground="{x:Null}" Background="#00FFFDFD">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource AudioContainerStyle}">
                                                        <StackPanel Margin="25,10,25,0">
                                                            <TextBlock Text="{Binding FileName, RelativeSource={RelativeSource AncestorType=UserControl}}"
           Foreground="White" FontFamily="Times New Roman"
           FontSize="14" FontWeight="Bold"
           TextTrimming="CharacterEllipsis"
           TextWrapping="Wrap" TextAlignment="Center"
           Margin="0,0,0,10"/>
                                                            <local:AudioPlayerControl FilePath="{Binding FilePath}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки Назад / Отменить -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Назад" Command="{Binding NavigateBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource ActionButtonGray}"
                        Margin="8,0,0,0"
                        Visibility="{Binding NavigationHistoryCount, Converter={StaticResource PositiveCountToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="50"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>