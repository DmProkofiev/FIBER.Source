<UserControl x:Class="FIBER.Source.Views.Search.AudioPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2008"
             mc:Ignorable="d"
             d:DesignHeight="170">
    <Border Background="#1F4E79" CornerRadius="8" Padding="10" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="{Binding FileName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="14" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <Border Background="#2A2A2A" CornerRadius="4" ClipToBounds="True"
                     Height="60"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <MediaElement x:Name="AudioMediaElement"
                                  LoadedBehavior="Manual"
                                  Stretch="None"
                                  Margin="0"
                                  Visibility="Collapsed"
                                  MediaOpened="AudioMediaElement_MediaOpened"/>
                </Grid>
            </Border>
            
            <Slider x:Name="AudioSlider"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Margin="0,10,0,0"
                    ValueChanged="AudioSlider_ValueChanged"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                <Button Content="Play" Click="Play_Click"
                        Style="{StaticResource MediaPlayButtonStyle}"
                        Margin="0,0,8,0" Width="40" Height="20"/>
                <Button Content="Pause" Click="Pause_Click"
                        Style="{StaticResource MediaPauseButtonStyle}"
                        Margin="0,0,8,0" Width="40" Height="20"/>
                <Button Content="Stop" Click="Stop_Click"
                        Style="{StaticResource MediaStopButtonStyle}"
                        Width="40" Height="20"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
