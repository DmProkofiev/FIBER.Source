<UserControl x:Class="FIBER.Source.Views.Search.VideoPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2008"
             mc:Ignorable="d"
             d:DesignHeight="230" d:DesignWidth="230" Width="230" Height="230">
    <Border Background="#F1C40F" CornerRadius="8" Padding="0,1,0,3">
        <StackPanel VerticalAlignment="Top">
            <!-- Видео контейнер с фиксированными размерами — занимает большую часть -->
            <Border Background="#000000" CornerRadius="4" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="224" Height="150" Margin="0,0,0,5">
                <Grid>
                    <MediaElement x:Name="VideoMediaElement"
                                  Width="224" Height="150"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Margin="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  MediaOpened="VideoMedia_MediaOpened"/>
                </Grid>
            </Border>
            <TextBlock Text="{Binding FileName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="Black" FontFamily="Times New Roman"
                       FontSize="11" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <Slider x:Name="VideoSlider"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    ValueChanged="VideoSlider_ValueChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Play" Click="Play_Click"
                        Style="{StaticResource MediaPlayButtonStyle}"
                        Margin="0,0,5,0" Width="36" Height="20"/>
                <Button Content="Pause" Click="Pause_Click"
                        Style="{StaticResource MediaPauseButtonStyle}"
                        Margin="0,0,5,0" Width="36" Height="20"/>
                <Button Content="Stop" Click="Stop_Click"
                        Style="{StaticResource MediaStopButtonStyle}"
                        Width="36" Height="20"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
