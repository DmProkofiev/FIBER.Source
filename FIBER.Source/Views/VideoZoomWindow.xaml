<Window x:Class="FIBER.Source.Views.VideoZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2008"
        mc:Ignorable="d"
        Title="Просмотр видео" WindowState="Maximized" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed">

    <Grid Background="#CC000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#88000000" Padding="10">
            <Grid>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Колесико: зум | Мышь: перемещение | Стрелки: листать | Esc: закрыть"
                               Foreground="Gray" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="×" Width="40" Height="40" FontSize="20" Click="Close_Click"
                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область видео -->
        <Grid Grid.Row="1" x:Name="ZoomContainer" ClipToBounds="True" Background="Transparent">
            <MediaElement x:Name="ZoomMediaElement"
                          LoadedBehavior="Manual"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0,0"
                          MouseWheel="Media_MouseWheel"
                          MouseLeftButtonDown="Media_MouseLeftButtonDown"
                          MouseLeftButtonUp="Media_MouseLeftButtonUp"
                          MouseMove="Media_MouseMove"
                          LostMouseCapture="Media_LostMouseCapture"
                          MediaOpened="Media_MediaOpened"
                          Cursor="SizeAll">
                <MediaElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="VideoScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="VideoTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </MediaElement.RenderTransform>
            </MediaElement>

            <!-- Кнопка назад -->
            <Button x:Name="PrevButton" Content="&lt;" Click="Prev_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="60" Height="100" Margin="20,0,0,0"
                    Background="#55000000" Foreground="White" FontSize="40"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Кнопка вперед -->
            <Button x:Name="NextButton" Content=">" Click="Next_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="60" Height="100" Margin="0,0,20,0"
                    Background="#55000000" Foreground="White" FontSize="40"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Панель управления (снизу) -->
        <Border Grid.Row="2" Background="#88000000" Padding="10">
            <StackPanel Margin="20,0,20,0">
                <Slider x:Name="PositionSlider"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Margin="0,0,0,10"
                        ValueChanged="PositionSlider_ValueChanged"
                        Thumb.DragStarted="PositionSlider_DragStarted"
                        Thumb.DragCompleted="PositionSlider_DragCompleted"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PlayButton" Content="Play" Click="Play_Click"
                            Style="{StaticResource MediaPlayButtonStyle}"
                            Width="60" Height="30" Margin="0,0,10,0"/>
                    <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click"
                            Style="{StaticResource MediaPauseButtonStyle}"
                            Width="60" Height="30" Margin="0,0,10,0"/>
                    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"
                            Style="{StaticResource MediaStopButtonStyle}"
                            Width="60" Height="30"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
